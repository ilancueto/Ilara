# Plantilla pública (sin secretos reales). Copiar a .env.local.
# Nunca subir .env.local ni service_role al repo.

# --- Obligatorias (app) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# --- Opcional: host de imágenes Storage para next/image ---
# NEXT_PUBLIC_SUPABASE_IMAGE_HOST=tu-proyecto.supabase.co

# --- Opcional: observabilidad (Stage 4) — docs/ETAPA4_OBSERVABILIDAD_RUNBOOK.md ---
# Sin DSN no hay telemetría externa. No instalar/configurar Sentry en CI sin decisión del owner.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# LOG_OBS=1

# --- E2E mutante: SOLO Supabase local (loopback). NUNCA producción. ---
# CI genera estas vars desde `supabase status`; local:
# E2E_SUPABASE_URL=http://127.0.0.1:54321
# E2E_ANON_KEY=
# E2E_SERVICE_ROLE_KEY=
# E2E_USER_EMAIL=e2e-admin@example.com
# E2E_USER_PASSWORD=E2E-Test-Pass-A1!
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# --- Smoke posdeploy (GET-only). Obligatorio para npm run test:smoke ---
# SMOKE_BASE_URL=http://127.0.0.1:3000
# SMOKE_BASE_URL=https://ilara.com.ar

# --- Opcional ---
# ANALYZE=true

# --- Stage 7 / Envia.com ---
# Se configura como secreto de Supabase Edge Functions, nunca NEXT_PUBLIC_.
# ENVIA_TOKEN=
